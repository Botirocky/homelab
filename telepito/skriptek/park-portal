    kerelem_tabla = f"<table>{sorok}</table>" if sorok else "<p>Nincs függő kérés.</p>"
    eng = ""
    for mac, e in sorted(engedett_olvas().items(), key=lambda x: x[1].get("engedve", 0), reverse=True):
        lejar = "örökre" if e.get("lejar") is None else time.strftime("%Y-%m-%d", time.localtime(e["lejar"]))
        eng += (f"<tr><td>{html.escape(e.get('email') or '')}<br><span class='kicsi'>{html.escape(e.get('nev') or '?')} · {mac} · lejár: {lejar}</span></td>"
                f"<td><form method='post' action='/a/tilt/{mac}'><button class='tilt'>Visszavon</button></form></td></tr>")
    return oldal("Wifi-hozzáférések", f"""
<h1>Függő kérések</h1>{kerelem_tabla}
<h1 style="margin-top:28px">Engedélyezett eszközök</h1><table>{eng}</table>""", frissit=15, szeles=True)


class Kezelo(BaseHTTPRequestHandler):
    server_version = "park-portal"
    sys_version = ""

    def log_message(self, fmt, *args):
        pass

    def kliens_ip(self):
        ip = self.client_address[0]
        return ip[7:] if ip.startswith("::ffff:") else ip

    def admin(self):
        try:
            cim = ipaddress.ip_address(self.kliens_ip())
        except ValueError:
            return False
        return any(cim in h for h in ADMIN_HALOK)

    def kuld(self, kod, torzs, tipus="text/html; charset=utf-8", fejlecek=None):
        adat = torzs.encode() if isinstance(torzs, str) else torzs
        self.send_response(kod)
        self.send_header("Content-Type", tipus)
        self.send_header("Content-Length", str(len(adat)))
        self.send_header("Cache-Control", "no-store")
        for kulcs, ertek in (fejlecek or {}).items():
            self.send_header(kulcs, ertek)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(adat)

    def atiranyit(self, hova):
        self.kuld(302, "", fejlecek={"Location": hova})

    def portal_cim(self, ut="/"):
        return f"http://{K['PORTAL_IP']}:{PORT}{ut}"

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        ut = urllib.parse.urlsplit(self.path).path
        if self.admin():
            if ut in ("/", "/admin"):
                return self.kuld(200, admin_oldal())
            return self.kuld(404, "nincs ilyen")
        host = (self.headers.get("Host") or "").split(":")[0]
        if host != K["PORTAL_IP"]:
            return self.atiranyit(self.portal_cim())
        mac = mac_ip_alapjan(self.kliens_ip())
        if ut.startswith("/v/"):
            return self.kuld(200, varakozas(ut[3:]))
        if mac and mac in engedett_olvas():
            return self.kuld(200, oldal("Csatlakozva", '<h1 class="ok">Ez az eszköz már engedélyezett</h1><p>Van internet.</p>'))
        return self.kuld(200, urlap())

    def torzs(self):
        hossz = min(int(self.headers.get("Content-Length") or 0), 4096)
        return urllib.parse.parse_qs(self.rfile.read(hossz).decode(errors="replace"))

    def do_POST(self):
        ut = urllib.parse.urlsplit(self.path).path
        if self.admin():
            return self.admin_post(ut)
        if ut != "/kerelem":
            return self.kuld(404, "nincs ilyen")
        ip = self.kliens_ip()
        mac = mac_ip_alapjan(ip)
        if not mac:
            return self.kuld(400, urlap("Nem sikerült azonosítani az eszközt. Csatlakozz újra a wifire."))
        most = time.time()
        with zar:
            hibak = [t for t in probalkozasok.get(mac, []) if most - t < 900]
            probalkozasok[mac] = hibak
        if len(hibak) >= 5:
            return self.kuld(429, urlap("Túl sok hibás próbálkozás. Várj 15 percet."))
        adat = self.torzs()
        email = (adat.get("email") or [""])[0].strip()
        jelszo = (adat.get("jelszo") or [""])[0].rstrip("\r\n")
        helyes = wifi_jelszo()
        if not EMAIL_MINTA.match(email):
            return self.kuld(400, urlap("Érvénytelen e-mail-cím.", email))
        if not helyes or not hmac.compare_digest(jelszo.encode(), helyes.encode()):
            with zar:
                probalkozasok.setdefault(mac, []).append(most)
            naplo(f"hibás jelszó: {mac} {ip} {email}")
            return self.kuld(403, urlap("Hibás wifi-jelszó.", email))
        with zar:
            kerelmek_takarit()
            for t, k in kerelmek.items():
                if k["mac"] == mac and k["allapot"] == "var":
                    return self.atiranyit(f"/v/{t}")
            token = secrets.token_urlsafe(18)
            kerelem = {"token": token, "mac": mac, "ip": ip, "email": email, "nev": eszkoz_nev(mac), "ido": most, "allapot": "var"}
            kerelmek[token] = kerelem
        naplo(f"új kérés: {email} {mac} {ip} {kerelem['nev']}")
        threading.Thread(target=ertesit, args=(kerelem,), daemon=True).start()
        return self.atiranyit(f"/v/{token}")

    def admin_post(self, ut):
        resz = ut.strip("/").split("/")
        if len(resz) == 3 and resz[0] == "d" and resz[2] in ("ok", "nem"):
            with zar:
                kerelmek_takarit()
                k = kerelmek.get(resz[1])
            if not k or k["allapot"] != "var":
                return self.kuld(404, "a kérés már nem érvényes", "text/plain; charset=utf-8")
            if resz[2] == "ok":
                enged(k["mac"], k["email"], k["nev"])
                kapcsolatok_bont(k["mac"])
                naplo(f"engedélyezve: {k['email']} {k['mac']}")
            else:
                naplo(f"elutasítva: {k['email']} {k['mac']}")
            k["allapot"] = resz[2]
        elif len(resz) == 3 and resz[0] == "a" and resz[1] == "tilt":
            tilt(resz[2])
            naplo(f"visszavonva: {resz[2]}")
        else:
            return self.kuld(404, "nincs ilyen", "text/plain; charset=utf-8")
        if "text/html" in (self.headers.get("Accept") or ""):
            return self.atiranyit("/admin")
        return self.kuld(200, "ok", "text/plain; charset=utf-8")


class Kiszolgalo(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def takarito():
    while True:
        time.sleep(3600)
        with zar:
            adat = engedett_olvas()
            most = time.time()
            lejart = [m for m, e in adat.items() if e.get("lejar") is not None and e["lejar"] <= most]
            for m in lejart:
                adat.pop(m)
            if lejart:
                engedett_ir(adat)
                naplo(f"lejárt: {', '.join(lejart)}")
            kerelmek_takarit()


def mac_ellenoriz(mac):
    if not re.fullmatch(r"([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}", mac):
        sys.exit(f"érvénytelen MAC: {mac}")
    return mac.lower()


def cli(args):
    if not args or args[0] == "lista":
        adat = engedett_olvas()
        if not adat:
            print("nincs engedélyezett eszköz")
        for mac, e in sorted(adat.items()):
            lejar = "örökre" if e.get("lejar") is None else time.strftime("%Y-%m-%d %H:%M", time.localtime(e["lejar"]))
            print(f"{mac}  {e.get('nev') or '?':<18} {e.get('email') or '':<30} lejár: {lejar}")
    elif args[0] == "enged" and len(args) >= 2:
        mac = mac_ellenoriz(args[1])
        idotartam = args[2] if len(args) > 2 else str(K["ERVENYES_NAP"])
        megj = args[3] if len(args) > 3 else "kézzel engedélyezve"
        if idotartam == "orokre":
            enged(mac, megj, eszkoz_nev(mac), orokre=True)
        else:
            enged(mac, megj, eszkoz_nev(mac), napok=int(idotartam))
        print(f"engedélyezve: {mac} ({idotartam}{'' if idotartam == 'orokre' else ' nap'})")
    elif args[0] == "tilt" and len(args) == 2:
        tilt(mac_ellenoriz(args[1]))
        print(f"visszavonva: {args[1]}")
    elif args[0] == "eszkozok":
        engedett = engedett_olvas()
        for ip, mac, eszk in arp_tabla():
            if eszk == K["INTERFESZ"] and mac != "00:00:00:00:00:00":
                print(f"{ip:<15} {mac}  {eszkoz_nev(mac) or '?':<18} {'ENGEDÉLYEZETT' if mac in engedett else 'nincs engedélye'}")
    else:
        print("""park-portal – captive portál a hotspothoz
  park-portal lista                    engedélyezett eszközök
  park-portal eszkozok                 a hotspoton most látható eszközök
  park-portal enged <MAC> [nap|orokre] [megjegyzés]
  park-portal tilt <MAC>
  park-portal szerver                  (a park-portal.service futtatja)
Jóváhagyás: ntfy-értesítés gombjai, vagy http://<tailscale-ip>:PORT/admin""")


def main():
    args = sys.argv[1:]
    if args[:1] == ["szerver"]:
        betolt()
        threading.Thread(target=takarito, daemon=True).start()
        srv = Kiszolgalo(("0.0.0.0", PORT), Kezelo)
        naplo(f"park-portal fut: {PORT}")
        srv.serve_forever()
    else:
        cli(args)


if __name__ == "__main__":
    main()
