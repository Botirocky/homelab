KONF = "/etc/park-portal.conf"
ALLAPOT_DIR = "/var/lib/park-portal"
ENGEDETT_FAJL = f"{ALLAPOT_DIR}/engedett.json"
NFT_FAJL = "/etc/park-portal/portal.nft"
LEASE_FAJL = "/var/lib/NetworkManager/dnsmasq-wlan0.leases"


def konf_olvas():
    k = {
        "PORT": "8077",
        "INTERFESZ": "wlan0",
        "PORTAL_IP": "10.42.0.1",
        "ADMIN_CIM": "100.64.0.1",
        "ERVENYES_NAP": "30",
        "KERELEM_PERC": "15",
        "JELSZO_FAJL": "/root/.hotspot-jelszo",
        "ENV_FAJL": "/srv/szerverpark/.env",
        "HALO_NEV": "picloud-net",
    }
    for fajl in (KONF,):
        try:
            with open(fajl) as f:
                for sor in f:
                    sor = sor.strip()
                    if sor and not sor.startswith("#") and "=" in sor:
                        kulcs, ertek = sor.split("=", 1)
                        k[kulcs.strip()] = ertek.strip().strip('"')
        except FileNotFoundError:
            pass
    return k


K = konf_olvas()
PORT = int(K["PORT"])
ERVENYES_MP = int(K["ERVENYES_NAP"]) * 86400
KERELEM_MP = int(K["KERELEM_PERC"]) * 60
ADMIN_HALOK = [ipaddress.ip_network(h) for h in ("100.64.0.0/10", "127.0.0.0/8", "fd7a:115c:a1e0::/48", "::1/128")]
EMAIL_MINTA = re.compile(r"^[^@\s<>\"']{1,64}@[^@\s<>\"']{1,190}\.[A-Za-z]{2,}$")

zar = threading.Lock()
kerelmek = {}
probalkozasok = {}


def naplo(szoveg):
    print(szoveg, flush=True)


def nft(*args, bemenet=None):
    return subprocess.run(["nft", *args], input=bemenet, capture_output=True, text=True)


def engedett_olvas():
    try:
        with open(ENGEDETT_FAJL) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def engedett_ir(adat):
    os.makedirs(ALLAPOT_DIR, exist_ok=True)
    ideiglenes = ENGEDETT_FAJL + ".uj"
    with open(ideiglenes, "w") as f:
        json.dump(adat, f, ensure_ascii=False, indent=1)
    os.replace(ideiglenes, ENGEDETT_FAJL)


def nft_elem_hozzaad(mac, lejar):
    if lejar is None:
        return nft("add", "element", "inet", "park_portal", "engedett", f"{{ {mac} }}").returncode == 0
    hatra = int(lejar - time.time())
    if hatra <= 0:
        return False
    return nft("add", "element", "inet", "park_portal", "engedett", f"{{ {mac} timeout {hatra}s }}").returncode == 0


def nft_elem_torol(mac):
    nft("delete", "element", "inet", "park_portal", "engedett", f"{{ {mac} }}")


def kapcsolatok_bont(mac):
    ip = None
    for sor in arp_tabla():
        if sor[1] == mac:
            ip = sor[0]
    if ip:
        subprocess.run(["conntrack", "-D", "-s", ip], capture_output=True)


def enged(mac, email, nev, napok=None, orokre=False):
    mac = mac.lower()
    lejar = None if orokre else time.time() + (napok * 86400 if napok else ERVENYES_MP)
    with zar:
        adat = engedett_olvas()
        adat[mac] = {"email": email, "nev": nev, "lejar": lejar, "engedve": time.time()}
        engedett_ir(adat)
    nft_elem_torol(mac)
    nft_elem_hozzaad(mac, lejar)


def tilt(mac):
    mac = mac.lower()
    with zar:
        adat = engedett_olvas()
        adat.pop(mac, None)
        engedett_ir(adat)
    nft_elem_torol(mac)
    kapcsolatok_bont(mac)


def betolt():
    r = nft("-f", NFT_FAJL)
    if r.returncode != 0:
        naplo(f"nft hiba: {r.stderr.strip()}")
        sys.exit(1)
    with zar:
        adat = engedett_olvas()
        most = time.time()
        lejartak = [m for m, e in adat.items() if e.get("lejar") is not None and e["lejar"] <= most]
        for m in lejartak:
            adat.pop(m)
        engedett_ir(adat)
    for mac, e in adat.items():
        nft_elem_hozzaad(mac, e.get("lejar"))
    naplo(f"tűzfal betöltve, {len(adat)} engedélyezett eszköz")


def arp_tabla():
    try:
        with open("/proc/net/arp") as f:
            return [(s.split()[0], s.split()[3].lower(), s.split()[5]) for s in f.readlines()[1:]]
    except OSError:
        return []


def mac_ip_alapjan(ip):
    for cim, mac, eszk in arp_tabla():
        if cim == ip and eszk == K["INTERFESZ"] and mac != "00:00:00:00:00:00":
            return mac
    subprocess.run(["ping", "-c1", "-W1", ip], capture_output=True)
    for cim, mac, eszk in arp_tabla():
        if cim == ip and eszk == K["INTERFESZ"] and mac != "00:00:00:00:00:00":
            return mac
    return None


def eszkoz_nev(mac):
    try:
        with open(LEASE_FAJL) as f:
            for sor in f:
                r = sor.split()
                if len(r) >= 4 and r[1].lower() == mac:
                    return r[3] if r[3] != "*" else ""
    except OSError:
        pass
    return ""


def wifi_jelszo():
    try:
        with open(K["JELSZO_FAJL"]) as f:
            return f.read().strip()
    except OSError:
        return None


def ntfy_cim():
    try:
        with open(K["ENV_FAJL"]) as f:
            for sor in f:
                if sor.startswith("NTFY_URL="):
                    return sor.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return None


def ertesit(kerelem):
    cim = ntfy_cim()
    if not cim:
        naplo("nincs NTFY_URL – az értesítés kimarad")
        return
    szerver, tema = cim.rstrip("/").rsplit("/", 1)
    alap = f"http://{K['ADMIN_CIM']}:{PORT}"
    torzs = {
        "topic": tema,
        "title": f"Csatlakozna a {K['HALO_NEV']}-re",
        "message": f"{kerelem['email']}\n{kerelem['nev'] or 'ismeretlen eszköz'} ({kerelem['mac']}, {kerelem['ip']})\n"
                   f"Engedélyezés {int(K['ERVENYES_NAP'])} napra.",
        "tags": ["wifi"],
        "priority": 4,
        "click": f"{alap}/admin",
        "actions": [
            {"action": "http", "label": "Engedélyez", "url": f"{alap}/d/{kerelem['token']}/ok", "method": "POST", "clear": True},
            {"action": "http", "label": "Tilt", "url": f"{alap}/d/{kerelem['token']}/nem", "method": "POST", "clear": True},
        ],
    }
    try:
        keres = urllib.request.Request(szerver, data=json.dumps(torzs).encode(), headers={"Content-Type": "application/json"})
        urllib.request.urlopen(keres, timeout=10).read()
    except Exception as e:
        naplo(f"ntfy hiba: {e}")


def kerelmek_takarit():
    most = time.time()
    for t in [t for t, k in kerelmek.items() if most - k["ido"] > KERELEM_MP and k["allapot"] == "var"]:
        kerelmek[t]["allapot"] = "lejart"
    for t in [t for t, k in kerelmek.items() if most - k["ido"] > 86400]:
        kerelmek.pop(t)


