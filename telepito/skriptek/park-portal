    k = kerelmek.get(token)
    if not k:
        return oldal("Ismeretlen kérés", '<h1>Ismeretlen kérés</h1><p>Kezdd újra.</p><p><a href="/">Vissza</a></p>')
    if k["allapot"] == "ok":
        return oldal("Csatlakozva", f'<h1 class="ok">Kész, van internet</h1><p>A hozzáférés {int(K["ERVENYES_NAP"])} napig érvényes ezen az eszközön.</p>')
    if k["allapot"] == "nem":
        return oldal("Elutasítva", '<h1 class="hiba">A kérést elutasították</h1><p>Kérdezd meg a hálózat gazdáját.</p>')
    if k["allapot"] == "lejart":
        return oldal("Lejárt", f'<h1>A kérés lejárt</h1><p>{int(K["KERELEM_PERC"])} percen belül nem hagyták jóvá.</p><p><a href="/">Új kérés</a></p>')
    return oldal("Jóváhagyásra vár", f"""
<h1>Jóváhagyásra vár…</h1>
<p>A kérést elküldtük ({html.escape(k['email'])}). Ez az oldal magától frissül; amint jóváhagyják, lesz internet.</p>
<p class="kicsi">Ne zárd be az oldalt.</p>""", frissit=4)


