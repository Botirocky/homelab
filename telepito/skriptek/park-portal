    kerelmek_takarit()
    sorok = ""
    for t, k in sorted(kerelmek.items(), key=lambda x: -x[1]["ido"]):
        if k["allapot"] != "var":
            continue
        sorok += (f"<tr><td>{html.escape(k['email'])}<br><span class='kicsi'>{html.escape(k['nev'] or '?')} · {k['mac']} · {k['ip']}</span></td>"
