#!/usr/bin/env python3
import hmac
import json
import os
import re
import secrets
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get("GEPEK_PORT", "8097"))
KULCS_FAJL = "/etc/park-gepek.kulcs"
HALOZAT = os.environ.get("GEPEK_HALOZAT", "192.168.1.0/24")
NEV_MINTA = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$")
MUVELETEK = {"indit", "leallit", "kenyszer"}

SUGO = """park-gepek – a virtuális gépek (libvirt, Incus) indítása/leállítása HTTP-n (ESP32 távirányítónak)

  park-gepek                 a szolgáltatás futtatása (a systemd indítja)
  park-gepek --lista         a gépek kiírása
  park-gepek --telepit       systemd szolgáltatás + kulcs + tűzfal (csak a helyi hálóról)
  park-gepek --kulcs         a kulcs kiírása
  park-gepek --eltavolit     a szolgáltatás leszedése

API (fejléc: X-Kulcs: <kulcs>):
  GET  /gepek                          [{"nev","tipus","allapot"}]
  POST /gepek/<tipus>/<nev>/<muvelet>  muvelet: indit | leallit | kenyszer
  GET  /ejszaka                        {"allapot","okok","kihagy","fut"}
  POST /ejszaka/leallit                kíméletes leállás indítása (park-ejszaka)
  POST /ejszaka/megse                  a várakozó leállás megszakítása
"""


def futtat(*parancs, ido=20):
    try:
        r = subprocess.run(parancs, capture_output=True, text=True, timeout=ido)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def libvirt_gepek():
    kod, ki, _ = futtat("virsh", "-c", "qemu:///system", "list", "--all", "--name")
    if kod:
        return []
    gepek = []
    for nev in filter(None, (s.strip() for s in ki.splitlines())):
        _, allapot, _ = futtat("virsh", "-c", "qemu:///system", "domstate", nev)
        gepek.append({"nev": nev, "tipus": "libvirt", "allapot": "fut" if allapot == "running" else "all" if allapot == "shut off" else allapot})
    return gepek


def incus_gepek():
    kod, ki, _ = futtat("incus", "list", "-f", "json")
    if kod:
        return []
    gepek = []
    for g in json.loads(ki or "[]"):
        st = g.get("status", "").lower()
        gepek.append({"nev": g["name"], "tipus": "incus", "allapot": "fut" if st == "running" else "all" if st == "stopped" else st})
    return gepek


def gepek():
    return libvirt_gepek() + incus_gepek()


def muvelet(tipus, nev, mit):
    if not any(g["tipus"] == tipus and g["nev"] == nev for g in gepek()):
        return 404, "nincs ilyen gép"
    if tipus == "libvirt":
        parancs = {"indit": "start", "leallit": "shutdown", "kenyszer": "destroy"}[mit]
        kod, ki, hiba = futtat("virsh", "-c", "qemu:///system", parancs, nev, ido=60)
    else:
        parancs = {"indit": ["start"], "leallit": ["stop"], "kenyszer": ["stop", "--force"]}[mit]
        kod, ki, hiba = futtat("incus", *parancs, nev, ido=90)
    return (200, "ok") if kod == 0 else (409, (hiba or ki or "hiba")[:200])


def ejszaka_allapot():
    kod, ki, _ = futtat("/usr/local/bin/park-ejszaka", "--json")
    try:
        a = json.loads(ki)
    except ValueError:
        a = {"allapot": "ismeretlen", "okok": []}
    a["fut"] = futtat("systemctl", "show", "-p", "ActiveState", "--value", "park-ejszaka.service")[1] in ("active", "activating")
    return a


def ejszaka_muvelet(mit):
    if mit == "leallit":
        kod, ki, hiba = futtat("systemctl", "start", "--no-block", "park-ejszaka.service")
    else:
        kod, ki, hiba = futtat("/usr/local/bin/park-ejszaka", "--megse")
    return (200, "ok") if kod == 0 else (409, (hiba or ki or "hiba")[:200])


def kulcs_olvas():
    try:
        with open(KULCS_FAJL) as f:
            return f.read().strip()
    except OSError:
        return ""


class Kezelo(BaseHTTPRequestHandler):
    server_version = "park-gepek"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))

    def valasz(self, kod, adat):
        test = json.dumps(adat, ensure_ascii=False).encode()
        self.send_response(kod)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(test)))
        self.end_headers()
        self.wfile.write(test)

    def jogos(self):
        k = kulcs_olvas()
        if k and hmac.compare_digest(self.headers.get("X-Kulcs", ""), k):
            return True
        self.valasz(403, {"hiba": "rossz kulcs"})
        return False

    def do_GET(self):
        ut = self.path.rstrip("/")
        if ut not in ("/gepek", "/ejszaka"):
            return self.valasz(404, {"hiba": "nincs ilyen"})
        if self.jogos():
            self.valasz(200, gepek() if ut == "/gepek" else ejszaka_allapot())

    def do_POST(self):
        r = self.path.strip("/").split("/")
        if len(r) == 2 and r[0] == "ejszaka" and r[1] in ("leallit", "megse"):
            if self.jogos():
                kod, uzenet = ejszaka_muvelet(r[1])
                self.valasz(kod, {"eredmeny": uzenet})
            return
        if len(r) != 4 or r[0] != "gepek" or r[1] not in ("libvirt", "incus") or r[3] not in MUVELETEK or not NEV_MINTA.match(r[2]):
            return self.valasz(404, {"hiba": "nincs ilyen"})
        if self.jogos():
            kod, uzenet = muvelet(r[1], r[2], r[3])
            self.valasz(kod, {"eredmeny": uzenet})


def telepit():
    if not os.path.exists(KULCS_FAJL):
        old = os.umask(0o077)
        with open(KULCS_FAJL, "w") as f:
            f.write(secrets.token_urlsafe(18) + "\n")
        os.umask(old)
    with open("/etc/systemd/system/park-gepek.service", "w") as f:
        f.write(f"""[Unit]
Description=park-gepek: VM-ek indítása/leállítása HTTP-n (ESP32 távirányítónak)
After=network-online.target libvirtd.service incus.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/park-gepek
Environment=GEPEK_PORT={PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
""")
    subprocess.run(["systemctl", "daemon-reload"], check=False)
    subprocess.run(["systemctl", "enable", "--now", "park-gepek.service"], check=False)
    subprocess.run(["systemctl", "restart", "park-gepek.service"], check=False)
    if subprocess.run(["sh", "-c", "command -v ufw >/dev/null && ufw status | grep -q 'Status: active'"]).returncode == 0:
        subprocess.run(["ufw", "allow", "from", HALOZAT, "to", "any", "port", str(PORT), "proto", "tcp", "comment", "park-gepek"],
                       check=False, stdout=subprocess.DEVNULL)


def eltavolit():
    subprocess.run(["systemctl", "disable", "--now", "park-gepek.service"], check=False)
    try:
        os.remove("/etc/systemd/system/park-gepek.service")
    except OSError:
        pass
    subprocess.run(["systemctl", "daemon-reload"], check=False)


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg in ("-h", "--help", "--sugo"):
        print(SUGO)
    elif arg == "--lista":
        for g in gepek():
            print(f"{g['tipus']:8} {g['allapot']:6} {g['nev']}")
    elif arg == "--telepit":
        telepit()
    elif arg == "--kulcs":
        print(kulcs_olvas())
    elif arg == "--eltavolit":
        eltavolit()
    else:
        ThreadingHTTPServer(("0.0.0.0", PORT), Kezelo).serve_forever()


if __name__ == "__main__":
    main()
